#!/bin/bash
# Keep the F4 light in step with the default microphone's mute state (PipeWire/Pulse).
# Lit = microphone muted, as on Windows. Runs as a systemd user service.
led=/sys/class/leds/platform::micmute/brightness
sync_led() {
  [[ -w $led ]] || return 0
  if pactl get-source-mute @DEFAULT_SOURCE@ 2>/dev/null | grep -q 'yes'; then echo 1 > "$led"; else echo 0 > "$led"; fi
}
until pactl info >/dev/null 2>&1; do sleep 1; done
sync_led
pactl subscribe | while read -r line; do
  case $line in *"on source"*|*"on server"*) sync_led ;; esac
done
