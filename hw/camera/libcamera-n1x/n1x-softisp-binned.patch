+/*
+ * Linear RGB for output row oy: per-colour average of the bin x bin raw block,
+ * black level removed and white-balance gains applied, 16-bit scale.
+ */
+void DebayerCpuThread::binAccumulate(uint32_t frame, const uint8_t *src, int oy, bool stats, int32_t *rgb[3])
+{
+	const unsigned int k = debayer_->bin_;
+	const Rectangle &window = debayer_->window_;
+	const unsigned int stride = debayer_->inputConfig_.stride;
+	const unsigned int bytesPP = debayer_->inputConfig_.bpp / 8;
+	const unsigned int outW = debayer_->binOutSize_.width;
+	const unsigned int order = debayer_->binOrder_;
+	const bool wide = bytesPP == 2;
+
+	for (unsigned int c = 0; c < 3; c++)
+		std::fill(binAcc_[c].begin(), binAcc_[c].end(), 0);
+
+	const uint8_t *winSrc = src + window.y * stride + window.x * bytesPP;
+	int cachedNext = -1;
+
+	for (unsigned int r = 0; r < k; r++) {
+		const unsigned int yy = oy * k + r; /* raw line inside the window */
+		const uint8_t *line = winSrc + yy * stride;
+		const uint8_t *lp[3];
+
+		/*
+		 * The camera buffers are uncached memory: element-wise reads from
+		 * them are very slow (measured: 3.75 fps), a bulk copy is not. So
+		 * copy each raw line once into a line buffer and work from there.
+		 */
+		const size_t lineBytes = static_cast<size_t>(window.width) * bytesPP;
+		if (enableInputMemcpy_) {
+			if (cachedNext == static_cast<int>(yy))
+				std::swap(binLines_[0], binLines_[1]);
+			else
+				memcpy(binLines_[0].data(), line, lineBytes);
+			lp[1] = binLines_[0].data();
+		} else {
+			lp[1] = line;
+		}
+		if (stats && !(yy & 1) && yy + 1 < window.height) {
+			if (enableInputMemcpy_) {
+				memcpy(binLines_[1].data(), line + stride, lineBytes);
+				cachedNext = yy + 1;
+				lp[2] = binLines_[1].data();
+			} else {
+				lp[2] = line + stride;
+			}
+			lp[0] = lp[2];
+			debayer_->stats_->processLine0(frame, yy, lp, threadIndex_);
+		}
+
+		uint32_t *a0 = binAcc_[(order >> ((yy & 1) * 4)) & 3].data();
+		uint32_t *a1 = binAcc_[(order >> ((yy & 1) * 4 + 2)) & 3].data();
+
+		if (wide) {
+			const uint16_t *p = reinterpret_cast<const uint16_t *>(lp[1]);
+			if (k == 2) {
+				for (unsigned int ox = 0; ox < outW; ox++) {
+					a0[ox] += p[2 * ox];
+					a1[ox] += p[2 * ox + 1];
+				}
+			} else {
+				unsigned int x = 0;
+				for (unsigned int ox = 0; ox < outW; ox++)
+					for (unsigned int j = 0; j < k; j++, x++)
+						((x & 1) ? a1 : a0)[ox] += p[x];
+			}
+		} else {
+			const uint8_t *p = lp[1];
+			unsigned int x = 0;
+			for (unsigned int ox = 0; ox < outW; ox++)
+				for (unsigned int j = 0; j < k; j++, x++)
+					((x & 1) ? a1 : a0)[ox] += p[x];
+		}
+	}
+
+	/* samples of each colour in a block depend on the block's parity when k is odd */
+	const unsigned int maxval = (1u << debayer_->binBits_) - 1;
+	uint64_t mul[2][3];
+	for (unsigned int px = 0; px < 2; px++) {
+		unsigned int cnt[3] = { 0, 0, 0 };
+		for (unsigned int r = 0; r < k; r++)
+			for (unsigned int j = 0; j < k; j++) {
+				unsigned int yy = oy * k + r, xx = px * k + j;
+				cnt[(order >> ((yy & 1) * 4 + (xx & 1) * 2)) & 3]++;
+			}
+		for (unsigned int c = 0; c < 3; c++)
+			mul[px][c] = (65535ull << 20) /
+				     (static_cast<uint64_t>(std::max(cnt[c], 1u)) * maxval);
+	}
+
+	for (unsigned int c = 0; c < 3; c++) {
+		const uint32_t *acc = binAcc_[c].data();
+		const int32_t black = debayer_->binBlack_[c];
+		const int32_t gain = debayer_->binGain_[c];
+		int32_t *out = rgb[c];
+		for (unsigned int ox = 0; ox < outW; ox++) {
+			int32_t v = static_cast<int32_t>((acc[ox] * mul[(ox * k) & 1][c]) >> 20) - black;
+			if (v < 0)
+				v = 0;
+			v = static_cast<int32_t>((static_cast<int64_t>(v) * gain) >> 10);
+			/* clip at sensor full scale so blown highlights stay neutral */
+			out[ox] = std::min(v, 65535);
+		}
+	}
+}
