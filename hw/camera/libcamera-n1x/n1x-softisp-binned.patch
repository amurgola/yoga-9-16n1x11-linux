+
+/**
+ * \brief Read ~/.config/n1x-camera.conf (key = value lines) when it changed
+ *
+ * Keys: bin (0/1), denoise, chroma, sharpen (0..100), contrast, saturation
+ * (floats, 1.0 = neutral). The path can be overridden with N1X_CAMERA_CONF.
+ */
+void DebayerCpu::loadBinTuning()
+{
+	if (binTuningPath_.empty()) {
+		const char *env = ::getenv("N1X_CAMERA_CONF");
+		const char *home = ::getenv("HOME");
+		if (env)
+			binTuningPath_ = env;
+		else if (home)
+			binTuningPath_ = std::string(home) + "/.config/n1x-camera.conf";
+		else
+			binTuningPath_ = "/etc/n1x-camera.conf";
+	}
+
+	struct stat st;
+	int64_t mtime = 0;
+	if (::stat(binTuningPath_.c_str(), &st) == 0)
+		mtime = static_cast<int64_t>(st.st_mtim.tv_sec) * 1000000000LL + st.st_mtim.tv_nsec;
+	if (mtime == binTuningMtime_)
+		return;
+	binTuningMtime_ = mtime;
+
+	BinTuning t;
+	std::ifstream file(binTuningPath_);
+	std::string line;
+	while (file && std::getline(file, line)) {
+		size_t hash = line.find('#');
+		if (hash != std::string::npos)
+			line.erase(hash);
+		size_t eq = line.find('=');
+		if (eq == std::string::npos)
+			continue;
+		auto trim = [](std::string v) {
+			size_t b = v.find_first_not_of(" \t\r");
+			size_t e = v.find_last_not_of(" \t\r");
+			return b == std::string::npos ? std::string() : v.substr(b, e - b + 1);
+		};
+		std::string key = trim(line.substr(0, eq));
+		std::string val = trim(line.substr(eq + 1));
+		char *end = nullptr;
+		double num = std::strtod(val.c_str(), &end);
+		if (end == val.c_str())
+			continue;
+		if (key == "bin")
+			t.enable = num != 0;
+		else if (key == "denoise")
+			t.denoise = std::clamp(static_cast<int>(num), 0, 100);
+		else if (key == "chroma")
+			t.chroma = std::clamp(static_cast<int>(num), 0, 100);
+		else if (key == "sharpen")
+			t.sharpen = std::clamp(static_cast<int>(num), 0, 100);
+		else if (key == "contrast")
+			t.contrast = std::clamp(static_cast<float>(num), 0.5f, 2.5f);
+		else if (key == "saturation")
+			t.saturation = std::clamp(static_cast<float>(num), 0.0f, 2.5f);
+	}
+	binTuning_ = t;
+	/* force the tables to be rebuilt */
+	binBlack_[0] = -1;
+	LOG(Debayer, Info)
+		<< "N1X tuning: bin=" << t.enable << " denoise=" << t.denoise
+		<< " chroma=" << t.chroma << " sharpen=" << t.sharpen
+		<< " contrast=" << t.contrast << " saturation=" << t.saturation;
+}
+
+void DebayerCpu::updateBinTables(const DebayerParams &params)
+{
+	const bool changed =
+		binBlack_[0] < 0 ||
+		params.gamma != params_.gamma ||
+		params.contrastExp != params_.contrastExp ||
+		params.blackLevel != params_.blackLevel ||
+		params.gains != params_.gains ||
+		!std::equal(params.combinedMatrix.data().begin(), params.combinedMatrix.data().end(),
+			    params_.combinedMatrix.data().begin());
+	if (!changed)
+		return;
+
+	const float contrastExp = params.contrastExp * binTuning_.contrast;
+	const float divisor = kBinGammaSize - 1.0;
+	for (unsigned int i = 0; i < kBinGammaSize; i++) {
+		float normalized = i / divisor;
+		if (normalized < 0.5)
+			normalized = 0.5 * std::pow(normalized / 0.5, contrastExp);
+		else
+			normalized = 1.0 - 0.5 * std::pow((1.0 - normalized) / 0.5, contrastExp);
+		binGamma_[i] = static_cast<uint8_t>(
+			std::clamp(UINT8_MAX * std::pow(normalized, params.gamma) + 0.5, 0.0, 255.0));
+	}
+
+	/* extra saturation around Rec. 601 luma, applied after the colour matrix */
+	const float sat = binTuning_.saturation;
+	const float luma[3] = { 0.299f, 0.587f, 0.114f };
+	for (unsigned int r = 0; r < 3; r++) {
+		for (unsigned int c = 0; c < 3; c++) {
+			float v = 0;
+			for (unsigned int k = 0; k < 3; k++) {
+				float satm = luma[k] * (1.0f - sat) + (r == k ? sat : 0.0f);
+				v += satm * params.combinedMatrix[k][c];
+			}
+			binMatrix_[r][c] = static_cast<int32_t>(std::lround(std::clamp(v, -8.0f, 8.0f) * 1024.0f));
+		}
+	}
+
+	const float black[3] = { params.blackLevel.r(), params.blackLevel.g(), params.blackLevel.b() };
+	const float gains[3] = { params.gains.r(), params.gains.g(), params.gains.b() };
+	for (unsigned int c = 0; c < 3; c++) {
+		binBlack_[c] = static_cast<int32_t>(std::clamp(black[c], 0.0f, 0.9f) * 65535.0f);
+		/* stretch what is left above black back to full scale, as the stock path does */
+		float stretch = 65535.0f / std::max(1.0f, 65535.0f - binBlack_[c]);
+		binGain_[c] = static_cast<int32_t>(std::clamp(gains[c] * stretch, 0.0f, 64.0f) * 1024.0f);
+	}
+}
