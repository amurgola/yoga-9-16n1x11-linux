+void DebayerCpuThread::processBinned(uint32_t frame, const uint8_t *src, uint8_t *dst)
+{
+	const int outW = debayer_->binOutSize_.width;
+	const int outH = debayer_->binOutSize_.height;
+	const unsigned int outputStride = debayer_->outputConfig_.stride;
+	const unsigned int bpp = debayer_->binOutBpp_;
+	const bool rgbOrder = debayer_->swapRedBlueGains_; /* BGR888 family: R first in memory */
+	const DebayerCpu::BinTuning tuning = debayer_->binTuning_;
+	const uint8_t *gammaLut = debayer_->binGamma_.data();
+	const int32_t (*m)[3] = debayer_->binMatrix_;
+
+	const unsigned int rawBytes = debayer_->window_.width * (debayer_->inputConfig_.bpp / 8) +
+				      2 * lineBufferPadding_;
+	for (auto &l : binLines_)
+		if (l.size() < rawBytes)
+			l.resize(rawBytes);
+	for (unsigned int c = 0; c < 3; c++) {
+		if (binAcc_[c].size() < static_cast<size_t>(outW))
+			binAcc_[c].resize(outW);
+		if (binAcc_r_.size() < static_cast<size_t>(outW)) {
+			binAcc_r_.resize(outW);
+			binAcc_g_.resize(outW);
+			binAcc_b_.resize(outW);
+		}
+		for (unsigned int slot = 0; slot < 3; slot++) {
+			if (binRows_[slot][c].size() < static_cast<size_t>(outW)) {
+				binRows_[slot][c].resize(outW);
+				binSum_[slot][c].resize(outW);
+				binYcc_[slot][c].resize(outW);
+			}
+		}
+	}
+
+	const int32_t dn = tuning.denoise * 205 / 100;	/* Q8, up to 0.8 */
+	const int32_t cdn = tuning.chroma * 256 / 100;	/* Q8, up to 1.0 */
+	const int32_t sh = tuning.sharpen * 384 / 100;	/* Q8, up to 1.5 */
+
+	int slotRow[3] = { -1, -1, -1 };
+	auto prepare = [&](int row) {
+		int slot = row % 3;
+		if (slotRow[slot] == row)
+			return;
+		slotRow[slot] = row;
+		int32_t *rgb[3] = { binRows_[slot][0].data(), binRows_[slot][1].data(), binRows_[slot][2].data() };
+		binAccumulate(frame, src, row,
+			      row >= static_cast<int>(yStart_) && row < static_cast<int>(yEnd_), rgb);
+		int32_t *Y = binYcc_[slot][0].data(), *Cr = binYcc_[slot][1].data(), *Cb = binYcc_[slot][2].data();
+		for (int x = 0; x < outW; x++) {
+			int32_t y = (rgb[0][x] + 2 * rgb[1][x] + rgb[2][x]) >> 2;
+			Y[x] = y;
+			Cr[x] = rgb[0][x] - y;
+			Cb[x] = rgb[2][x] - y;
+		}
+		for (unsigned int c = 0; c < 3; c++) {
+			const int32_t *v = binYcc_[slot][c].data();
+			int32_t *s = binSum_[slot][c].data();
+			s[0] = 2 * v[0] + v[std::min(1, outW - 1)];
+			for (int x = 1; x < outW - 1; x++)
+				s[x] = v[x - 1] + v[x] + v[x + 1];
+			if (outW > 1)
+				s[outW - 1] = v[outW - 2] + 2 * v[outW - 1];
+		}
+	};
+
+	dst += yStart_ * outputStride;
+	for (int oy = yStart_; oy < static_cast<int>(yEnd_); oy++, dst += outputStride) {
+		const int up = std::max(oy - 1, 0), dnRow = std::min(oy + 1, outH - 1);
+		prepare(up);
+		prepare(oy);
+		prepare(dnRow);
+
+		const int32_t *Y = binYcc_[oy % 3][0].data();
+		const int32_t *Cr = binYcc_[oy % 3][1].data();
+		const int32_t *Cb = binYcc_[oy % 3][2].data();
+		const int32_t *sY[3] = { binSum_[up % 3][0].data(), binSum_[oy % 3][0].data(), binSum_[dnRow % 3][0].data() };
+		const int32_t *sR[3] = { binSum_[up % 3][1].data(), binSum_[oy % 3][1].data(), binSum_[dnRow % 3][1].data() };
+		const int32_t *sB[3] = { binSum_[up % 3][2].data(), binSum_[oy % 3][2].data(), binSum_[dnRow % 3][2].data() };
+		uint8_t *o = dst;
+
+		const int rOff = rgbOrder ? 0 : 2, bOff = rgbOrder ? 2 : 0;
+		const int32_t m00 = m[0][0], m01 = m[0][1], m02 = m[0][2];
+		const int32_t m10 = m[1][0], m11 = m[1][1], m12 = m[1][2];
+		const int32_t m20 = m[2][0], m21 = m[2][1], m22 = m[2][2];
+		int32_t *ro = binAcc_r_.data(), *go = binAcc_g_.data(), *bo = binAcc_b_.data();
+
+		/* filter + colour matrix on whole rows: plain int32 so the compiler can vectorise */
+		for (int x = 0; x < outW; x++) {
+			/* 3x3 means: sum of nine * 455 >> 12 */
+			const int32_t yMean = ((sY[0][x] + sY[1][x] + sY[2][x]) * 455) >> 12;
+			const int32_t crMean = ((sR[0][x] + sR[1][x] + sR[2][x]) * 455) >> 12;
+			const int32_t cbMean = ((sB[0][x] + sB[1][x] + sB[2][x]) * 455) >> 12;
+
+			int32_t y = Y[x];
+			const int32_t d = y - yMean;
+			const int32_t ad = d < 0 ? -d : d;
+			/* noise threshold growing with the signal, capped */
+			const int32_t thr = std::min(40 + ((y + 4096) >> 5), 1200);
+			const int32_t under = std::min(ad, thr);
+			const int32_t over = ad - under;
+			const int32_t delta = ((sh * over) >> 8) - ((dn * under) >> 8);
+			y += d < 0 ? -delta : delta;
+
+			const int32_t cr = Cr[x] + ((cdn * (crMean - Cr[x])) >> 8);
