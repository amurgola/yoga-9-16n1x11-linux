# Local package (see README.md in this directory for what you have to supply yourself): speakers/headphones/mics for the Lenovo Yoga 9 2-in-1 16N1X11
# (machine type 83N7, NVIDIA RTX Spark N1X, card mt8901-soundwire).
#
# 1. Cirrus CS35L56 firmware + per-amp tuning, SoundWire subsystem ID 17AA:3802
#    (ACPI _SUB "380217AA"). Without it the 4 amps run ROM 3.4.4 and each one
#    downmixes L+R -> quiet, flat, mono. Lenovo ships it only in the Windows
#    Cirrus extension driver XuCsMeExt_3802_FDL 1.0.755.1740; the files in
#    cirrus-win/ were copied unmodified from that DriverStore package on this
#    laptop's own Windows install. Names follow what the cs35l56 driver requests
#    on N1x (same scheme as omarchy-pkgs asus-proart-p14-audio):
#      Windows SS0/SS1 (speaker vendor)  -> -spkid0 / -spkid1
#      Windows *_l1uN                    -> -l1uN  (link 1, SoundWire unique id N)
#    Amp positions verified by ear: u0,u4 front-left; u1,u5 front-right.
#    Drop this part once linux-firmware ships cs35l56-b0-dsp1-misc-17aa3802-*.
#
# 2. ALSA UCM for mt8901-soundwir from alsa-project/alsa-ucm-conf#862
#    (NVIDIA, head 7d3555a). All files unmodified EXCEPT HiFi-cs42l43-cs35l56x4.conf:
#    this laptop's tweeters sit on the CS42L43 speaker outputs, which upstream
#    never enables, so we route them (with Lenovo's 4.5 kHz crossover) and move
#    the jack onto DL0. See that file's header. Report upstream before dropping;
#    once alsa-ucm-conf ships it, the files will conflict, which is the signal.

pkgname=lenovo-83n7-audio
pkgver=1.0.755.1740
pkgrel=2
pkgdesc='CS35L56 amp firmware/tuning and mt8901 UCM for the Lenovo Yoga 9 2-in-1 16N1X11 (83N7, N1X)'
arch=('aarch64')
license=('LicenseRef-Cirrus' 'BSD-3-Clause')   # the Cirrus files stay under Cirrus' own terms; they are not in this repository
depends=('alsa-ucm-conf')
options=('!strip' '!debug')

package() {
  local win="$startdir/cirrus-win"
  local dest="$pkgdir/usr/lib/firmware/cirrus"
  local base=cs35l56-b0-dsp1-misc-17aa3802
  local ss spk side u

  for ss in 0 1; do
    install -Dm644 "$win/b0_dflt_35l56_3.13.5.wmfw" "$dest/$base-spkid$ss.wmfw"
    for side in LW:0 RW:1 LW:4 RW:5; do
      u=${side#*:}
      install -Dm644 "$win/b0_dflt_SS${ss}_3802_${side%:*}_l1u$u.bin" "$dest/$base-spkid$ss-l1u$u.bin"
    done
  done

  local ucm="$pkgdir/usr/share/alsa/ucm2"
  install -Dm644 -t "$ucm/MediaTek/mt8901-soundwir" "$startdir"/ucm2/*.conf
  install -d "$ucm/conf.d/mt8901-soundwir"
  ln -s ../../MediaTek/mt8901-soundwir/mt8901-soundwir.conf "$ucm/conf.d/mt8901-soundwir/mt8901-soundwir.conf"

}
